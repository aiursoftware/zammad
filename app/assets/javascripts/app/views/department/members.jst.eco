<div class="wcl-members">
  <label class="wcl-members-search">
    <span><%- @T('Add people') %></span>
    <input type="search" class="form-control js-search" value="<%= @query %>" placeholder="<%- @Ti('Type a name or email (at least 2 letters)') %>" autocomplete="off">
  </label>

  <% if @query.trim().length >= 2: %>
    <% if @candidates.length is 0: %>
      <p class="wcl-members-empty"><%- @T('No one else matches.') %></p>
    <% else: %>
      <ul class="wcl-members-list wcl-members-list--candidates">
        <% for user in @candidates: %>
          <li>
            <div class="wcl-members-who">
              <strong><%= user.name %></strong>
              <span><%= user.email %></span>
              <% if user.department: %><span class="wcl-members-current"><%= App.i18n.translatePlain('currently: %s', user.department) %></span><% end %>
            </div>
            <button type="button" class="btn btn--small btn--success js-add" data-id="<%= user.id %>"><%- @T('Add') %></button>
          </li>
        <% end %>
      </ul>
    <% end %>
  <% end %>

  <h3 class="wcl-members-heading"><%- @T('In this department') %> <span class="wcl-members-count"><%= @members.length %></span></h3>
  <% if @members.length is 0: %>
    <p class="wcl-members-empty"><%- @T('Nobody yet. Search above to add people.') %></p>
  <% else: %>
    <ul class="wcl-members-list">
      <% for user in @members: %>
        <li>
          <div class="wcl-members-who">
            <strong><%= user.name %></strong>
            <span><%= user.email %></span>
          </div>
          <button type="button" class="btn btn--small btn--subtle js-remove" data-id="<%= user.id %>" title="<%- @Ti('Remove from department') %>"><%- @T('Remove') %></button>
        </li>
      <% end %>
    </ul>
  <% end %>
</div>
