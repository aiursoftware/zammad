<div class="main flex wcl-report">
  <div class="page-header">
    <div class="page-header-title">
      <h1><%- @T('Maintenance Report') %></h1>
    </div>
  </div>

  <form class="wcl-report-filters js-form">
    <label class="wcl-report-field">
      <span><%- @T('From') %></span>
      <input type="date" name="from" class="form-control" value="<%= @from %>" required>
    </label>
    <label class="wcl-report-field">
      <span><%- @T('To') %></span>
      <input type="date" name="to" class="form-control" value="<%= @to %>" required>
    </label>
    <label class="wcl-report-field wcl-report-field--wide">
      <span><%- @T('Group') %></span>
      <select name="group_id" class="form-control">
        <option value=""><%- @T('All my groups') %></option>
        <% for group in @groups: %>
          <option value="<%= group.id %>" <%= 'selected' if group.id is @selectedGroupId %>><%= group.name %></option>
        <% end %>
      </select>
    </label>
    <div class="wcl-report-actions">
      <button type="submit" class="btn btn--primary"><%- @T('Show') %></button>
      <button type="button" class="btn js-download"><%- @T('Download Excel') %></button>
    </div>
  </form>

  <div class="js-result" aria-live="polite"></div>
</div>
