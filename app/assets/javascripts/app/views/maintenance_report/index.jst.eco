<div class="page-header">
  <div class="page-header-title">
    <h1><%- @T('Maintenance Report') %></h1>
  </div>
</div>
<div class="page-content">
  <form class="horizontal js-form" style="gap: 12px; flex-wrap: wrap; align-items: flex-end; margin-bottom: 20px;">
    <div class="form-group">
      <div class="formGroup-label"><label for="maintenance-report-from"><%- @T('From') %></label></div>
      <div class="controls"><input id="maintenance-report-from" type="date" name="from" class="form-control" value="<%= @from %>"></div>
    </div>
    <div class="form-group">
      <div class="formGroup-label"><label for="maintenance-report-to"><%- @T('To') %></label></div>
      <div class="controls"><input id="maintenance-report-to" type="date" name="to" class="form-control" value="<%= @to %>"></div>
    </div>
    <div class="form-group" style="min-width: 220px;">
      <div class="formGroup-label"><label for="maintenance-report-group"><%- @T('Group') %></label></div>
      <div class="controls">
        <select id="maintenance-report-group" name="group_id" class="form-control">
          <option value=""><%- @T('All my groups') %></option>
          <% for group in @groups: %>
            <option value="<%= group.id %>" <%= 'selected' if group.id is @selectedGroupId %>><%= group.name %></option>
          <% end %>
        </select>
      </div>
    </div>
    <div class="form-group">
      <button type="submit" class="btn btn--primary"><%- @T('Show') %></button>
      <button type="button" class="btn js-download"><%- @T('Download Excel') %></button>
    </div>
  </form>
  <div class="js-result"></div>
</div>
