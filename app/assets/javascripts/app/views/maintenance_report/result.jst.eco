<section class="wcl-report-overview">
  <p class="wcl-report-lead"><%= @lead.text %></p>

  <% if @lead.submitted > 0: %>
    <div class="wcl-flow" role="img" aria-label="<%= @flowLabel %>">
      <% for part in @flow when part.value > 0: %>
        <span class="wcl-flow-part wcl-flow-part--<%= part.key %>" style="flex-grow: <%= part.value %>"></span>
      <% end %>
    </div>
    <ul class="wcl-flow-legend">
      <% for part in @flow: %>
        <li class="wcl-flow-legend-item wcl-flow-legend-item--<%= part.key %>">
          <span class="wcl-flow-swatch"></span>
          <%= part.label %> <strong><%= part.value %></strong>
          <span class="wcl-muted">(<%= part.percent %>%)</span>
        </li>
      <% end %>
    </ul>
  <% end %>

  <dl class="wcl-kpis">
    <% for kpi in @kpis: %>
      <div class="wcl-kpi">
        <dt><%= kpi.label %></dt>
        <dd>
          <span class="wcl-kpi-value"><%= kpi.value %></span>
          <% if kpi.link: %>
            <a class="wcl-kpi-note" href="<%= kpi.link %>" title="<%= kpi.note %>"><%= kpi.note %></a>
          <% else if kpi.note: %>
            <span class="wcl-kpi-note"><%= kpi.note %></span>
          <% end %>
        </dd>
      </div>
    <% end %>
  </dl>
</section>

<% renderTable = (table) => %>
  <section class="wcl-panel <%= table.className or '' %>">
    <header class="wcl-panel-head">
      <h2><%= table.title %></h2>
      <% if table.hint: %><p class="wcl-muted"><%= table.hint %></p><% end %>
    </header>
    <% if table.rows.length is 0: %>
      <p class="wcl-empty"><%= table.empty %></p>
    <% else: %>
      <div class="wcl-table-wrap">
        <table class="wcl-table">
          <thead>
            <tr>
              <% for column in table.columns: %>
                <th class="<%= 'is-number' if column.numeric %>" scope="col"><%= column.label %></th>
              <% end %>
            </tr>
          </thead>
          <tbody>
            <% for row in table.rows: %>
              <tr>
                <% for column, index in table.columns: %>
                  <% value = row[column.key] %>
                  <% if index is 0: %>
                    <th scope="row" class="<%= 'is-unset' if value is '(none)' or value is '(unassigned)' %>">
                      <%= if value is '(none)' then @T('Not set') else if value is '(unassigned)' then @T('Unassigned') else value %>
                    </th>
                  <% else if column.bar: %>
                    <td class="is-number is-bar">
                      <span class="wcl-bar" style="width: <%= if table.max[column.key] then Math.round((value or 0) / table.max[column.key] * 100) else 0 %>%"></span>
                      <span class="wcl-bar-value"><%= value %></span>
                    </td>
                  <% else: %>
                    <td class="<%= 'is-number' if column.numeric %>"><%= if value? then value else '–' %></td>
                  <% end %>
                <% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </section>
<% end %>

<% if _.every(@tables, (table) -> table.rows.length is 0): %>
  <p class="wcl-report-nothing"><%- @T('Nothing to break down for this period. Try a wider date range or another group.') %></p>
<% else: %>
  <div class="wcl-report-grid">
    <% for table in @tables: %>
      <%- renderTable(table) %>
    <% end %>
  </div>
<% end %>
