# Copy to .env and fill in. Keep .env out of git.

# The address agents and the HR app use, e.g. support.worldcraftlogistics.net. Its DNS A record
# must point at this server before the first start (for the HTTPS certificate).
ZAMMAD_FQDN=support.worldcraftlogistics.net

# Database password; generate one: openssl rand -base64 24
POSTGRES_PASSWORD=

# The image built from this repository.
IMAGE=wcl/zammad:latest

TZ=Asia/Ho_Chi_Minh

# Elasticsearch memory (1g is fine for a few thousand tickets; 2g beyond that).
ES_HEAP=1g

# Ports Caddy listens on.
HTTP_PORT=80
HTTPS_PORT=443
